// 类型函数在编译期执行，参数可以是常量或用 T: type 声明的类型。
// 计算值域用于运行期存储时需要物理封口，已确定布局的类型可以直接使用。

type below(n: uint8) {
    return uint8[0, n - 1];
}

type mask_of(bits: uint8) {
    define value = 1;
    define i: uint8 = 0;
    while (i < bits) {
        value *= 2;
        i += 1;
    }
    return uint16[0, value - 1];
}

type upto(n: uint8) {
    if (n == 0) { return uint8[0, 0]; }
    return upto(n - 1) | uint8[0, n];
}

type choose(flag: boolean) {
    if (flag) { return uint8[0, 3]; }
    return uint8[4, 7];
}

type Row(T: type, length: uint8) {
    return array · {len: length, elem: T};
}

type Matrix(T: type, rows: uint8, cols: uint8) {
    return Row(Row(T, cols), rows);
}

type Cell = {value: uint16[0, 1000]};
type Grid = Matrix(Cell, 3, 4);

define grid_value(grid: Grid, row: below(3) in {uint8} 8, col: below(4) in {uint8} 8) -> uint16[0, 1000] {
    return grid[row][col].value;
}

// 计算出的下标集合直接当作数组下标的下界证明，不需要任何运行期判断。
define pick(table: uint8[4], i: below(4) in {uint8} 8) -> uint8 {
    return table[i];
}

define masked_index(table: uint8[4], raw: uint8, mask: mask_of(2) in {uint8} 8) -> uint8 {
    return table[raw & mask];
}

define band(flag: boolean) -> uint8 {
    define lo: choose(true) in {uint8} 8 = 3;
    define hi: choose(false) in {uint8} 8 = 4;
    if (flag) { return lo; }
    return hi;
}

// 同一个类型函数换个参数就落到更宽的容器：0..511 装不进 uint8。
define wide_mask() -> uint16 {
    define value: mask_of(9) in {uint8, uint16, uint32} 32 = 511;
    return value;
}

// 递归的类型函数：upto(n) 是 [0, n]。
define narrow(value: uint8, bound: upto(3) in {uint8} 8) -> uint8 {
    if (value > bound) { return bound; }
    return value;
}

define main() -> int32 {
    define table: uint8[4] = [10, 20, 30, 40];

    define index: below(4) in {uint8} 8 = 2;
    if (pick(table, index) != 30) { return 1; }

    define low: mask_of(2) in {uint8} 8 = 3;
    if (masked_index(table, 6, low) != 30) { return 2; }
    if (masked_index(table, 255, low) != 40) { return 3; }

    if (band(true) != 3) { return 4; }
    if (band(false) != 4) { return 5; }

    if (wide_mask() != 511) { return 6; }

    if (narrow(9, 3) != 3) { return 7; }
    if (narrow(2, 3) != 2) { return 8; }

    define grid: Grid;
    grid[2][3].value = 700;
    if (grid_value(grid, 2, 3) != 700) { return 9; }

    return 0;
}
