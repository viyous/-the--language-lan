    if (int_sqrt(1000000) != 1000) { return 60; }
    if (int_sqrt(4294967295) != 65535) { return 61; }
    if (int_sqrt(65535) != 255) { return 62; }
    if (int_sqrt(65536) != 256) { return 63; }

    define one: uint8[16] = [42, 42, 42, 42, 42, 42, 42, 42, 42, 42, 42, 42, 42, 42, 42, 42];
    if (lower_bound(one, 42) != 0) { return 64; }
    if (upper_bound(one, 42) != 16) { return 65; }
