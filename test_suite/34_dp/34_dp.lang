    define k2: Seq = [115, 105, 116, 116, 105, 110, 103, 0, 0, 0, 0, 0, 0, 0, 0, 0];
    if (edit_distance(k1, 6, k2, 7) != 3) { return 7; }
    if (edit_distance(k1, 6, k1, 6) != 0) { return 8; }
    if (edit_distance(k1, 0, k2, 7) != 7) { return 9; }
    if (edit_distance(k1, 6, k1, 0) != 6) { return 10; }

