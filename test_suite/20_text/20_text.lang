type Label = { name: ascii_string · {len: [0, 16]}, code: uint16 };
type Title = { text: string · {len: [0, 32]}, level: uint8[1, 6] };
type Entry = { key: ascii_string · {len: [1, 8]}, label: Label };

define is_digit(c: ascii) -> boolean { return c >= '0' && c <= '9'; }
define is_lower(c: ascii) -> boolean { return c >= 'a' && c <= 'z'; }
define is_upper(c: ascii) -> boolean { return c >= 'A' && c <= 'Z'; }
define is_letter(c: ascii) -> boolean { return is_lower(c) || is_upper(c); }
define is_space(c: ascii) -> boolean { return c == ' '; }

define is_vowel(c: ascii) -> boolean {
    define l: ascii = to_lower(c);
    return l == 'a' || l == 'e' || l == 'i' || l == 'o' || l == 'u';
}

define to_upper(c: ascii) -> ascii {
    define d: uint8 = c as uint8;
    if (d >= 97 && d <= 122) { return (d - 32) as ascii; }
    return c;
}

define to_lower(c: ascii) -> ascii {
    define d: uint8 = c as uint8;
    if (d >= 65 && d <= 90) { return (d + 32) as ascii; }
    return c;
}

define digit_value(c: ascii) -> uint8[0, 9] {
    define d: uint8 = c as uint8;
    if (d >= 48 && d <= 57) { return d - 48; }
    return 0;
}

define text_len(s: ascii_string · {len: [0, 64]}) -> uint8 {
    return s.len as uint8;
}

define utf8_len(s: string · {len: [0, 64]}) -> uint8 {
    return s.len as uint8;
}

define byte_at(s: ascii_string · {len: [9, 64]}, i: uint8[0, 8]) -> ascii {
    return s[i];
}

define count_digits(s: ascii_string · {len: [0, 32]}) -> uint8[0, 32] {
    define n: uint8 = 0;
    define i: uint8 = 0;
    while (i < 32 && i < s.len) {
        if (is_digit(s[i])) { n += 1; }
        i += 1;
    }
    return n;
}

define count_letters(s: ascii_string · {len: [0, 32]}) -> uint8[0, 32] {
    define n: uint8 = 0;
    define i: uint8 = 0;
    while (i < 32 && i < s.len) {
        if (is_letter(s[i])) { n += 1; }
        i += 1;
    }
    return n;
}

define count_vowels(s: ascii_string · {len: [0, 32]}) -> uint8[0, 32] {
    define n: uint8 = 0;
    define i: uint8 = 0;
    while (i < 32 && i < s.len) {
        if (is_vowel(s[i])) { n += 1; }
        i += 1;
    }
    return n;
}

define count_spaces(s: ascii_string · {len: [0, 32]}) -> uint8[0, 32] {
    define n: uint8 = 0;
    define i: uint8 = 0;
    while (i < 32 && i < s.len) {
        if (is_space(s[i])) { n += 1; }
        i += 1;
    }
    return n;
}

define checksum(s: ascii_string · {len: [0, 32]}) -> uint32 {
    define sum: uint32 = 0;
    define i: uint8 = 0;
    while (i < 32 && i < s.len && sum < 100000) {
        sum += s[i] as uint32;
        i += 1;
    }
    return sum;
}

define parse_uint(s: ascii_string · {len: [1, 8]}) -> uint32 {
    define value: uint32 = 0;
    define i: uint8 = 0;
    while (i < 8 && i < s.len && value < 100000 && is_digit(s[i])) {
        value = value * 10 + (digit_value(s[i]) as uint32);
        i += 1;
    }
    return value;
}

define upper_gain(s: ascii_string · {len: [0, 32]}) -> uint8[0, 32] {
    define n: uint8 = 0;
    define i: uint8 = 0;
    while (i < 32 && i < s.len) {
        if (is_lower(s[i])) { n += 1; }
        i += 1;
    }
    return n;
}

define same_text(a: ascii_string · {len: [0, 16]}, b: ascii_string · {len: [0, 16]}) -> boolean {
    return a === b;
}

define prefix3(s: ascii_string · {len: [3, 64]}) -> ascii_string · {from: 0} {
    return s[0, 3);
}

define suffix2(s: ascii_string · {len: [2, 64]}) -> ascii_string · {from: 0} {
    define n: uint8 = s.len as uint8;
    define lo: uint8 = n - 2;
    return s[lo, n);
}

define label_len(l: Label) -> uint8 {
    return l.name.len as uint8;
}

define label_code(l: Label) -> uint16 {
    return l.code;
}

define title_bytes(t: Title) -> uint8 {
    return t.text.len as uint8;
}

define title_level(t: Title) -> uint8[1, 6] {
    return t.level;
}

define entry_key_len(e: Entry) -> uint8 {
    return e.key.len as uint8;
}

define entry_label_len(e: Entry) -> uint8 {
    return e.label.name.len as uint8;
}

define main() -> int32 {

    if (text_len("hello") != 5) { return 1; }
    if (text_len("") != 0) { return 2; }

    if (byte_at("abcdefghi", 0) != 'a') { return 3; }
    if (byte_at("abcdefghi", 8) != 'i') { return 4; }

    if (!is_digit('7')) { return 5; }
    if (is_digit('x')) { return 6; }
    if (!is_lower('m')) { return 7; }
    if (!is_upper('M')) { return 8; }
    if (is_letter('-')) { return 9; }
    if (to_upper('q') != 'Q') { return 10; }
    if (to_upper('Q') != 'Q') { return 11; }
    if (to_lower('Q') != 'q') { return 12; }
    if (digit_value('8') != 8) { return 13; }

    if (count_digits("a1b2c3") != 3) { return 14; }
    if (count_letters("a1b2c3") != 3) { return 15; }
    if (count_vowels("education") != 5) { return 16; }
    if (count_vowels("xyz") != 0) { return 17; }
    if (count_spaces("a b c") != 2) { return 18; }

    if (checksum("abc") != 294) { return 19; }
    if (checksum("") != 0) { return 20; }

    if (parse_uint("123") != 123) { return 21; }
    if (parse_uint("7") != 7) { return 22; }
    if (parse_uint("12x9") != 12) { return 23; }

    if (upper_gain("Hello World") != 8) { return 24; }

    define a: ascii_string = "abc";
    define b: ascii_string = "abc";
    define c: ascii_string = "abd";
    if (!same_text(a, b)) { return 25; }
    if (same_text(a, c)) { return 26; }

    define p = prefix3("abcdef");
    if (p.len != 3) { return 27; }
    if (p[0] != 'a') { return 28; }
    define q = suffix2("abcdef");
    if (q.len != 2) { return 29; }
    if (q[1] != 'f') { return 30; }

    define raw: ascii_string = "lan";
    define cs: c_string = raw as: view c_string;
    if (cs.len != 3) { return 31; }

    if (utf8_len("héllo") != 6) { return 32; }
    if (utf8_len("hello") != 5) { return 33; }

    define l: Label = { name: "alpha", code: 7 };
    if (label_len(l) != 5) { return 34; }
    if (label_code(l) != 7) { return 35; }

    define t: Title = { text: "start", level: 3 };
    if (title_bytes(t) != 5) { return 36; }
    if (title_level(t) != 3) { return 37; }

    define e: Entry = { key: "id", label: l as: copy };
    if (entry_key_len(e) != 2) { return 38; }
    if (entry_label_len(e) != 5) { return 39; }

    return 0;
}
