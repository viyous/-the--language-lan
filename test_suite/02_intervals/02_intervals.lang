type Percent = uint8[0, 100];

type HalfRange = uint8[0, 128);

type Interior = uint8(0, 255);

type AtLeastTen = uint8 & >= 10;
type AtMostTen = uint8 & <= 10;

type Teens = uint8 & >= 10 & <= 20;

define to_percent(x: uint8[0, 100]) -> Percent {
    return x;
}

define halve(x: uint8[0, 254]) -> HalfRange {
    return x / 2;
}

define interior_mid(x: Interior) -> Interior {
    return x;
}

define clamp_percent(x: uint16) -> Percent {
    if (x > 100) { return 100; }
    return x as: trunc uint8;
}

define clamp(x: uint8, lo: uint8, hi: uint8 & >= lo) -> uint8 & >= lo & <= hi {
    if (x < lo) { return lo; }
    if (x > hi) { return hi; }
    return x;
}

define stretch(x: Percent) -> uint16[0, 200] {
    return (x as uint16) * 2;
}

define shrink(x: uint16[0, 200]) -> Percent {
    return (x / 2) as uint8;
}

define shift_up(x: uint8[0, 100]) -> uint8[10, 110] {
    return x + 10;
}

define branchy(x: boolean) -> uint8[0, 200] {
    if (x) { return 200; }
    return 0;
}

define at_least(x: AtLeastTen) -> AtLeastTen {
    return x;
}

define bump(x: AtLeastTen) -> AtLeastTen {
    if (x < 250) { return x + 1; }
    return x;
}

define is_teen(x: uint8) -> boolean {
    return x in Teens;
}

define rebase(x: AtLeastTen) -> uint8 {
    return x - 10;
}

define span_width(lo: uint8, hi: uint8 & >= lo) -> uint8 {
    return hi - lo;
}

define overlap(lo1: uint8, hi1: uint8 & >= lo1,
               lo2: uint8, hi2: uint8 & >= lo2) -> uint8 {
    if (hi1 < lo2) { return 0; }
    if (hi2 < lo1) { return 0; }
    return 1;
}

define count_to(n: uint8[0, 200]) -> uint8[0, 200] {
    define i: uint8 = 0;
    while (i < n) {
        i += 1;
    }
    return i;
}

define halvings(x: uint16[1, 65535]) -> uint8[0, 16] {
    define v: uint16 = x;
    define steps: uint8 = 0;
    while (v > 1 && steps < 16) {
        v = v / 2;
        steps += 1;
    }
    return steps;
}

define main() -> int32 {
    if (to_percent(100) != 100) { return 1; }
    if (halve(254) != 127) { return 2; }
    if (interior_mid(100) != 100) { return 3; }
    if (clamp_percent(1000) != 100) { return 4; }
    if (clamp_percent(42) != 42) { return 5; }

    if (clamp(5, 10, 90) != 10) { return 6; }
    if (clamp(95, 10, 90) != 90) { return 7; }
    if (clamp(50, 10, 90) != 50) { return 8; }

    if (stretch(100) != 200) { return 9; }
    if (shrink(200) != 100) { return 10; }
    if (shift_up(90) != 100) { return 11; }
    if (branchy(true) != 200) { return 12; }
    if (branchy(false) != 0) { return 13; }

    if (at_least(10) != 10) { return 14; }
    if (bump(10) != 11) { return 15; }
    if (!is_teen(15)) { return 16; }
    if (is_teen(9)) { return 17; }
    if (rebase(10) != 0) { return 18; }

    if (span_width(10, 90) != 80) { return 19; }
    if (overlap(0, 10, 5, 15) != 1) { return 20; }
    if (overlap(0, 10, 20, 30) != 0) { return 21; }

    if (count_to(200) != 200) { return 22; }
    if (halvings(65535) != 15) { return 23; }

    return 0;
}
