extern contract ext_popcount32(x: uint32) -> uint32[0, 32] writes {};
extern contract ext_clamp(v: int32, lo: int32, hi: int32) -> int32 writes {};
extern contract ext_clamp100(v: int32) -> int32[0, 100] writes {};
extern contract ext_sign(v: int32) -> int32[-1, 1] writes {};
extern contract ext_sum_bytes(data: uint8[..], n: uint64) -> uint64[0, 1020] writes {};
extern contract ext_hash(data: uint8[..], n: uint64) -> uint32 writes {};
extern contract ext_fill(dst: uint8[..], n: uint64, v: uint8) -> void writes { dst };
extern contract ext_max4(a: uint8[4]) -> uint8 writes {};
extern contract ext_mix(a: uint64, b: uint64) -> uint64 writes {};

define bits_set(x: uint32) -> uint8[0, 32] {
    define n: uint32 = ext_popcount32(x);
    return n as uint8;
}

define sign_of(v: int32) -> int32[-1, 1] {
    return ext_sign(v);
}

define clamped100(v: int32) -> int32[0, 100] {
    return ext_clamp100(v);
}

define bounded(v: int32) -> int32[0, 100] {
    define lo: int32 = 0;
    define hi: int32 = 100;
    define r: int32 = ext_clamp(v, lo, hi);
    if (r < 0) { return 0; }
    if (r > 100) { return 100; }
    return r;
}

define sign_class(v: int32) -> uint8[0, 2] {
    define s: int32 = ext_sign(v);
    if (s < 0) { return 0; }
    if (s > 0) { return 2; }
    return 1;
}

define max_of_four(a: uint8[4]) -> uint8 {
    return ext_max4(a);
}

define sum_of(a: uint8[4]) -> uint64 {
    define n: uint64 = 4;
    return ext_sum_bytes(a[0, 4), n);
}

define hash_of(a: uint8[4]) -> uint32 {
    define n: uint64 = 4;
    return ext_hash(a[0, 4), n);
}

define fill_all(a: uint8[4], v: uint8) -> void {
    define n: uint64 = 4;
    ext_fill(a[0, 4), n, v);
}

define fill_head(a: uint8[4], v: uint8) -> void {
    define n: uint64 = 2;
    ext_fill(a[0, 2), n, v);
}

define sum_loop(a: uint8[4]) -> uint64 {
    define total: uint64 = 0;
    define i: uint8 = 0;
    while (i < 4 && total < 100000) {
        define one: uint64 = ext_sum_bytes(a[i, i + 1), 1);
        total += one;
        i += 1;
    }
    return total;
}

define is_byte_aligned(x: uint32) -> boolean {
    define n: uint8 = bits_set(x);
    return n % 8 == 0;
}

define mix_high(a: uint64, b: uint64) -> uint32 {
    define m: uint64 = ext_mix(a, b);
    define hi: uint64 = m >> 32;
    return hi as: sat uint32;
}

define main() -> int32 {

    if (bits_set(0) != 0) { return 1; }
    if (bits_set(0x0F) != 4) { return 2; }
    if (bits_set(0xFF) != 8) { return 3; }
    if (bits_set(0xFFFFFFFF) != 32) { return 4; }

    if (sign_of(-9) != -1) { return 5; }
    if (sign_of(0) != 0) { return 6; }
    if (sign_of(9) != 1) { return 7; }
    if (clamped100(-5) != 0) { return 8; }
    if (clamped100(50) != 50) { return 9; }
    if (clamped100(500) != 100) { return 10; }

    if (bounded(-3) != 0) { return 11; }
    if (bounded(42) != 42) { return 12; }
    if (bounded(300) != 100) { return 13; }

    if (sign_class(-1) != 0) { return 14; }
    if (sign_class(0) != 1) { return 15; }
    if (sign_class(7) != 2) { return 16; }

    define a: uint8[4] = [3, 9, 1, 4];
    if (max_of_four(a) != 9) { return 17; }
    if (sum_of(a) != 17) { return 18; }
    if (hash_of(a) == 0) { return 19; }

    define b: uint8[4] = [0, 0, 0, 0];
    fill_all(b, 7);
    if (b[0] != 7) { return 20; }
    if (b[3] != 7) { return 21; }

    define c: uint8[4] = [1, 2, 3, 4];
    fill_head(c, 5);
    if (c[0] != 5) { return 22; }
    if (c[1] != 5) { return 23; }
    if (c[2] != 3) { return 24; }
    if (c[3] != 4) { return 25; }

    if (sum_loop(a) != 17) { return 26; }

    if (!is_byte_aligned(0xFF)) { return 27; }
    if (is_byte_aligned(0x0F)) { return 28; }

    if (mix_high(1, 2) != 1) { return 29; }
    if (mix_high(0, 5) != 0) { return 30; }

    return 0;
}
