import { Small, add_small, sat_sub } from "./lib_math.lang";

type Stats = { min: Small, max: Small, count: uint8[0, 8] };

define empty() -> Stats {
    return { min: 0, max: 0, count: 0 };
}

define observe(s: Stats, v: Small) -> Stats {
    define lo: Small = s.min;
    define hi: Small = s.max;
    define n: uint8 = s.count;
    if (n == 0) {
        return { min: v, max: v, count: 1 };
    }
    if (v < lo) { lo = v; }
    if (v > hi) { hi = v; }
    if (n < 8) { n += 1; }
    return { min: lo, max: hi, count: n };
}

define span(s: Stats) -> Small {
    return sat_sub(s.max, s.min);
}

define total_of(a: Small, b: Small, c: Small, d: Small) -> uint16[0, 400] {
    define ab: uint16 = add_small(a, b);
    define cd: uint16 = add_small(c, d);
    return ab + cd;
}

define count_of(s: Stats) -> uint8[0, 8] {
    return s.count;
}

export { Stats, empty, observe, span, total_of, count_of };
